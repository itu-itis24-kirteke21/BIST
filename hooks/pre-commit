#!/bin/sh
# ==========================================================
# BIST 100 Analiz Sistemi - Pre-Commit Hook
# ==========================================================
# Bu hook, her git commit oncesinde pytest'i calistirir.
# Testler basarisiz olursa commit islemine izin verilmez.
#
# Kurulum:
#   cp hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# veya PowerShell:
#   Copy-Item hooks/pre-commit .git/hooks/pre-commit
#
# Atlamak icin (acil durumlarda):
#   git commit --no-verify -m "mesaj"
# ==========================================================

echo ""
echo "==========================================="
echo "  BIST Pre-Commit: Testler calistiriliyor"
echo "==========================================="
echo ""

# pytest'i calistir
python -m pytest --tb=short -q

# Cikis kodunu kontrol et
if [ $? -ne 0 ]; then
    echo ""
    echo "==========================================="
    echo "  COMMIT IPTAL EDILDI!"
    echo "  Testler basarisiz oldu."
    echo "  Hatalari duzeltip tekrar commit edin."
    echo ""
    echo "  Acil atlamak icin:"
    echo "    git commit --no-verify -m \"mesaj\""
    echo "==========================================="
    echo ""
    exit 1
fi

echo ""
echo "  Tum testler basarili - commit devam ediyor."
echo "==========================================="
echo ""
exit 0
