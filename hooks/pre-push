#!/bin/sh
# ==========================================================
# BIST 100 Analiz Sistemi - Pre-Push Hook
# ==========================================================
# Bu hook, her git push oncesinde tam test paketini calistirir.
# Pre-commit'ten farkli olarak detayli cikti verir.
# ==========================================================

echo ""
echo "==========================================="
echo "  BIST Pre-Push: Tam test paketi calisiyor"
echo "==========================================="
echo ""

python -m pytest -v

if [ $? -ne 0 ]; then
    echo ""
    echo "==========================================="
    echo "  PUSH IPTAL EDILDI!"
    echo "  Testler basarisiz oldu."
    echo "  Hatalari duzeltip tekrar push edin."
    echo ""
    echo "  Acil atlamak icin:"
    echo "    git push --no-verify"
    echo "==========================================="
    echo ""
    exit 1
fi

echo ""
echo "  Tum testler basarili - push devam ediyor."
echo "==========================================="
echo ""
exit 0
