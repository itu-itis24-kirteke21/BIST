#!/bin/sh
# ==========================================================
# BIST 100 Analiz Sistemi - Pre-Push Hook
# ==========================================================
# Bu hook, her git push oncesinde:
#   1. Ruff linter kontrolu (detayli)
#   2. Ruff format kontrolu
#   3. Pytest -v (detayli test ciktisi)
# calistirir. Herhangi biri basarisiz olursa push engellenir.
#
# Atlamak icin (acil durumlarda):
#   git push --no-verify
# ==========================================================

echo ""
echo "==========================================="
echo "  BIST Pre-Push: Tam kontrol paketi"
echo "==========================================="

# ----------------------------------------------------------
# 1. Ruff Lint
# ----------------------------------------------------------
echo ""
echo "  [1/3] Ruff lint kontrolu..."
python -m ruff check .

if [ $? -ne 0 ]; then
    echo ""
    echo "  PUSH IPTAL: Lint hatalari bulundu!"
    echo "  Duzeltmek icin: ruff check --fix ."
    echo "==========================================="
    exit 1
fi
echo "        Lint temiz."

# ----------------------------------------------------------
# 2. Ruff Format
# ----------------------------------------------------------
echo "  [2/3] Ruff format kontrolu..."
python -m ruff format --check .

if [ $? -ne 0 ]; then
    echo ""
    echo "  PUSH IPTAL: Format uyumsuzluklari bulundu!"
    echo "  Duzeltmek icin: ruff format ."
    echo "==========================================="
    exit 1
fi
echo "        Format temiz."

# ----------------------------------------------------------
# 3. Pytest (Detayli)
# ----------------------------------------------------------
echo "  [3/3] Pytest calistiriliyor (detayli)..."
python -m pytest -v

if [ $? -ne 0 ]; then
    echo ""
    echo "  PUSH IPTAL: Testler basarisiz!"
    echo "  Hatalari duzeltip tekrar push edin."
    echo "==========================================="
    exit 1
fi

echo ""
echo "  Tum kontroller basarili - push devam ediyor."
echo "==========================================="
echo ""
exit 0
